# API
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require&channel_binding=require"
JWT_SECRET="change-me-in-production"
PORT=5000
API_ORIGIN="http://localhost:5000"
WEB_ORIGIN="http://localhost:3000"
ROOT_DOMAIN="ordersawa.com"
DOMAIN_VERIFY_BYPASS="true"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="menu-builder"
CORS_ORIGINS="http://localhost:3000,http://localhost:5000"
TRUST_PROXY=""
REQUEST_BODY_LIMIT_KB=256
MAX_UPLOAD_MB=75
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=900000

# Web
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="ordersawa.com"
