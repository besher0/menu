# Copy to a PRIVATE file outside releases. Never commit the populated file.
ORDERSAWA_ENV=staging
NODE_ENV=production
ORDERSAWA_RELEASE_ID=staging-REPLACE_WITH_COMMIT
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=5432
STAGING_DB_NAME=ordersawa_staging
# Set both to the isolated staging database; migration role must own its schema.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
PUBLIC_WHATSAPP_CHECKOUT_HMAC_KEY=
INTERNAL_RESTAURANT_REWRITE_SECRET=
ENABLE_PUBLIC_NETWORK_WHATSAPP_CHECKOUT=1
DOMAIN_VERIFY_BYPASS=false
API_HOST=127.0.0.1
PORT=5000
WEB_PORT=3000
TRUST_PROXY=127.0.0.1
# Replace all example hosts consistently, using the dedicated staging domain.
WEB_ORIGIN=https://staging.example.invalid
API_ORIGIN=https://staging.example.invalid/api
CORS_ORIGINS=https://staging.example.invalid
ROOT_DOMAIN=staging.example.invalid
NEXT_PUBLIC_WEB_URL=https://staging.example.invalid
NEXT_PUBLIC_ROOT_DOMAIN=staging.example.invalid
NEXT_PUBLIC_API_URL=/api
# Existing server-side API setting (historical name); required for SSR with relative browser API.
ORDERSAWA_PREVIEW_INTERNAL_API_URL=http://127.0.0.1:5000
NEXT_TELEMETRY_DISABLED=1
# Existing local-media setting; keep persistent storage OUTSIDE versioned releases.
ORDERSAWA_DEMO_UPLOADS_DIR=/srv/ordersawa-staging/shared/uploads
MAX_UPLOAD_MB=75
REQUEST_BODY_LIMIT_KB=256
# Optional EXISTING provider; do not copy production credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ordersawa-staging
# Smoke test uses an existing synthetic staging account only, never Production.
STAGING_SMOKE_EMAIL=
STAGING_SMOKE_PASSWORD=
STAGING_SMOKE_RESTAURANT_SLUG=
# Optional bootstrap on EMPTY staging DB only. Existing databases are refused.
STAGING_BOOTSTRAP_ADMIN_EMAIL=
STAGING_BOOTSTRAP_ADMIN_PASSWORD=
STAGING_SMOKE_WHATSAPP_PHONE=
