{
  "name": "@menu/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "preview:network-whatsapp": "npm run build && node dist/modules/orders/network-order-whatsapp-preview.js",
    "test:product-configuration:integration": "vitest run src/modules/products/product-editor.integration.spec.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:backfill-product-configurations": "tsx prisma/backfill-product-configurations.ts",
    "typecheck:product-configuration-tools": "tsc -p prisma/tsconfig.product-configuration.json",
    "prisma:backfill-libraries": "tsx prisma/backfill-product-libraries.ts",
    "prisma:reset-user-password": "tsx prisma/reset-user-password.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed.ts --demo",
    "seed:stage5-public-demo": "tsx prisma/seed-stage5-public-demo.ts",
    "seed:stage6d2b-network-order-demo": "tsx prisma/seed-stage6d2b-network-order-demo.ts"
  },
  "dependencies": {
    "@menu/shared": "0.1.0",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "file-type": "^21.3.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "jszip": "^3.10.1",
    "multer": "2.5.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "~4.1.12"
  }
}
